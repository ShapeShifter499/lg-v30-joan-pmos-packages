# Maintainer: Lance <Gero3977@gmail.com>
maintainer="Lance <Gero3977@gmail.com>"
pkgname=firmware-lge-joan-owner
pkgver=1.0
pkgrel=0
pkgdesc="LG V30 (joan) modem, ADSP, IPA and WLAN firmware"
url="https://github.com/ShapeShifter499/firmware-lge-joan-blobs"
arch="aarch64"
license="custom"
depends="firmware-lge-joan"
options="!check !strip !archcheck !spdx !tracedeps pmb:cross-native"

# These images live in the phone's modem and dsp partitions, not the vendor
# partition TheMuppets dumps, so there is no upstream to fetch them from: 47 of
# the 48 appear nowhere in their joan trees.  They are hosted separately and
# pinned by commit, the way TheMuppets, FairBlobs and sdm845-mainline host
# blobs for other devices, so this repository stays text-only.
_commit="6723629581f8e29303a70870f96c2a6d03230c18"
source="$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz"
builddir="$srcdir/firmware-lge-joan-blobs-$_commit"

prepare() {
	default_prepare

	# The archive checksum covers the download; this covers the contents.
	# MANIFEST.tsv records origin, destination, size and sha256 per file, so a
	# truncated or swapped blob fails here and names itself rather than
	# producing a package with a hole in it.
	msg "Verifying firmware against MANIFEST.tsv"
	local _src _dst _size _sha _actual _file _missing=0 _bad=0 _seen=0
	while IFS="$(printf '\t')" read -r _src _dst _size _sha || [ -n "$_src" ]; do
		case "$_src" in \#*|"") continue ;; esac

		_file="$builddir/$_dst"
		if ! [ -f "$_file" ]; then
			error "missing: $_dst"
			_missing=$((_missing + 1))
			continue
		fi
		_seen=$((_seen + 1))
		_actual=$(sha256sum "$_file" | cut -d' ' -f1)
		if [ "$_actual" != "$_sha" ]; then
			error "sha256 mismatch: $_dst"
			_bad=$((_bad + 1))
		fi
	done < "$builddir/MANIFEST.tsv"

	if [ "$_missing" -ne 0 ] || [ "$_bad" -ne 0 ]; then
		error "firmware failed verification: $_missing missing, $_bad mismatched"
		return 1
	fi
	if [ "$_seen" -eq 0 ]; then
		error "MANIFEST.tsv yielded no records; is the archive intact?"
		return 1
	fi
	msg "verified $_seen firmware files"
}

package() {
	local _src _dst _size _sha
	while IFS="$(printf '\t')" read -r _src _dst _size _sha || [ -n "$_src" ]; do
		case "$_src" in \#*|"") continue ;; esac
		install -Dm644 "$builddir/$_dst" "$pkgdir/usr/lib/firmware/$_dst"
	done < "$builddir/MANIFEST.tsv"

	# ath10k looks for this at the top of the firmware tree.
	ln -s qcom/msm8998/joan/wlanmdsp.mbn "$pkgdir/usr/lib/firmware/wlanmdsp.mbn"

	install -Dm644 "$builddir/LICENSE.qcom" \
		"$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 "$builddir/NOTICE.txt" \
		"$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}

sha512sums="
03d737ff5e495dd05986520f9ef6261f386f8cb8edddb70a78f176d5143a22a4d0c9ddfa0155aa3f18b17f885e6a214367e4aa99faa15008c0fe12d9c29e9863  firmware-lge-joan-owner-6723629581f8e29303a70870f96c2a6d03230c18.tar.gz
"
