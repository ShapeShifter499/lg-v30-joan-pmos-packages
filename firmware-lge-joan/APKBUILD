# Maintainer: Lance <Gero3977@gmail.com>
maintainer="Lance <Gero3977@gmail.com>"
pkgname=firmware-lge-joan
pkgver=1.0
pkgrel=6
pkgdesc="Firmware for the LG V30 (joan)"
url="https://github.com/ShapeShifter499/lg-v30-joan-pmos-packages"
arch="aarch64"
license="custom"
subpackages="
	$pkgname-adreno-h930:adreno_h930
	$pkgname-adreno-h932:adreno_h932
	$pkgname-bluetooth:bluetooth
	$pkgname-modem:modem
	$pkgname-adsp:adsp
	$pkgname-ipa:ipa
	$pkgname-wifi:wifi
	$pkgname-initramfs:firmware_initramfs:noarch
	"
options="!check !strip !archcheck !spdx !tracedeps pmb:cross-native"

# GPU, zap-shader and Bluetooth firmware is redistributable and comes from
# commit-pinned TheMuppets vendor trees.
_joan_commit="2489e95801110695e991394245b6d7ae66670c4e"
_common_commit="274a1e49a783b971eb967f6afd303b3ec38c9a1b"
_joan_url="https://raw.githubusercontent.com/TheMuppets/proprietary_vendor_lge_joan/$_joan_commit/proprietary/vendor/firmware"
_common_url="https://raw.githubusercontent.com/TheMuppets/proprietary_vendor_lge_joan-common/$_common_commit/proprietary/vendor/firmware"

# The modem, ADSP, IPA and WLAN images live in the device's modem and dsp
# partitions rather than the vendor partition TheMuppets dumps, so there is
# nothing upstream to fetch: they are hosted separately and pinned by commit.
_blobs_commit="6723629581f8e29303a70870f96c2a6d03230c18"
_blobs_url="https://github.com/ShapeShifter499/firmware-lge-joan-blobs"
_blobs="$srcdir/firmware-lge-joan-blobs-$_blobs_commit"
_fwdir="/usr/lib/firmware"

source="
	a540_gpmu.fw2::$_common_url/a540_gpmu.fw2
	crbtfw21.tlv::$_common_url/crbtfw21.tlv
	crnv21.bin::$_common_url/crnv21.bin
	H930-a540_zap.mdt::$_joan_url/H930/a540_zap.mdt
	H930-a540_zap.b00::$_joan_url/H930/a540_zap.b00
	H930-a540_zap.b01::$_joan_url/H930/a540_zap.b01
	H930-a540_zap.b02::$_joan_url/H930/a540_zap.b02
	H932-a540_zap.mdt::$_joan_url/H932/a540_zap.mdt
	H932-a540_zap.b00::$_joan_url/H932/a540_zap.b00
	H932-a540_zap.b01::$_joan_url/H932/a540_zap.b01
	H932-a540_zap.b02::$_joan_url/H932/a540_zap.b02
	firmware-lge-joan-blobs-$_blobs_commit.tar.gz::$_blobs_url/archive/$_blobs_commit.tar.gz
	joan-firmware-variant
	30-lge-joan-gpu.files
	NOTICE.txt
	LICENSE.qcom
	"

prepare() {
	default_prepare

	# The archive sum covers the download; this covers the contents, and
	# survives the archive being regenerated.
	msg "Verifying hosted firmware against MANIFEST.tsv"
	local _src _dst _size _sha _actual _missing=0 _bad=0 _seen=0
	while IFS="$(printf '\t')" read -r _src _dst _size _sha || [ -n "$_src" ]; do
		case "$_src" in \#*|"") continue ;; esac
		if ! [ -f "$_blobs/$_dst" ]; then
			error "missing: $_dst"
			_missing=$((_missing + 1))
			continue
		fi
		_seen=$((_seen + 1))
		_actual=$(sha256sum "$_blobs/$_dst" | cut -d' ' -f1)
		if [ "$_actual" != "$_sha" ]; then
			error "sha256 mismatch: $_dst"
			_bad=$((_bad + 1))
		fi
	done < "$_blobs/MANIFEST.tsv"

	if [ "$_missing" -ne 0 ] || [ "$_bad" -ne 0 ] || [ "$_seen" -eq 0 ]; then
		error "hosted firmware failed verification: $_seen verified, $_missing missing, $_bad mismatched"
		return 1
	fi
	msg "verified $_seen hosted firmware files"
}

package() {
	# The parent carries only the licence and the diagnostic, as
	# firmware-qcom-adreno does; the firmware itself is in the subpackages.
	install -Dm644 "$srcdir/LICENSE.qcom" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 "$srcdir/NOTICE.txt" "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
	install -Dm755 "$srcdir/joan-firmware-variant" "$pkgdir/usr/bin/joan-firmware-variant"
}

# The A540 zap shader is the only firmware that differs between Joan models,
# and only .mdt and .b01 differ at that -- .b00 and .b02 are byte-identical.
# What varies is the signature, not the shader.  An exact LG-H932 needs the
# H932 set; every other variant, LG-H932PR included, needs the H930 one.  Each
# package carries a complete set, so there is no way to end up half-installed.
_adreno() {
	local _part _variant="$1"
	depends="firmware-qcom-adreno-a530"
	provides="$pkgname-adreno=$pkgver-r$pkgrel"
	install="$subpkgname.post-install"

	install -Dm644 "$srcdir/a540_gpmu.fw2" "$subpkgdir$_fwdir/qcom/a540_gpmu.fw2"
	for _part in mdt b00 b01 b02; do
		install -Dm644 "$srcdir/$_variant-a540_zap.$_part" \
			"$subpkgdir$_fwdir/qcom/a540_zap.$_part"
	done
}

adreno_h930() {
	pkgdesc="LG V30 Adreno 540 firmware (H930, US998, H932PR, non-H932)"
	depends="!$pkgname-adreno-h932"
	_adreno H930
}

adreno_h932() {
	pkgdesc="LG V30 Adreno 540 firmware (LG-H932 only, differently signed)"
	depends="!$pkgname-adreno-h930"
	_adreno H932
}

bluetooth() {
	pkgdesc="LG V30 Bluetooth firmware"
	install -Dm644 "$srcdir/crbtfw21.tlv" "$subpkgdir$_fwdir/qca/crbtfw21.tlv"
	install -Dm644 "$srcdir/crnv21.bin" "$subpkgdir$_fwdir/qca/crnv21.bin"
}

modem() {
	pkgdesc="LG V30 modem firmware"
	install -Dm644 "$_blobs"/qcom/msm8998/joan/modem.* \
		"$_blobs"/qcom/msm8998/joan/mba.mbn \
		-t "$subpkgdir$_fwdir/qcom/msm8998/joan/"
}

adsp() {
	pkgdesc="LG V30 ADSP firmware"
	install -Dm644 "$_blobs"/qcom/msm8998/joan/adsp.* \
		-t "$subpkgdir$_fwdir/qcom/msm8998/joan/"
}

ipa() {
	pkgdesc="LG V30 IPA firmware"
	install -Dm644 "$_blobs"/ipa_fws.* -t "$subpkgdir$_fwdir/"
}

wifi() {
	pkgdesc="LG V30 WLAN firmware"
	depends="linux-firmware-ath10k"
	install -Dm644 "$_blobs"/qcom/msm8998/joan/wlanmdsp.mbn \
		-t "$subpkgdir$_fwdir/qcom/msm8998/joan/"
	install -Dm644 "$_blobs"/ath10k/WCN3990/hw1.0/board.bin \
		-t "$subpkgdir$_fwdir/ath10k/WCN3990/hw1.0/"
	# ath10k looks for this at the top of the firmware tree.
	ln -s qcom/msm8998/joan/wlanmdsp.mbn "$subpkgdir$_fwdir/wlanmdsp.mbn"
}

firmware_initramfs() {
	pkgdesc="Early GPU and Bluetooth firmware list for the LG V30 initramfs"
	depends="$pkgname-adreno $pkgname-bluetooth"

	install -Dm644 "$srcdir/30-lge-joan-gpu.files" \
		"$subpkgdir/usr/share/mkinitfs/files/30-lge-joan-gpu.files"
}
