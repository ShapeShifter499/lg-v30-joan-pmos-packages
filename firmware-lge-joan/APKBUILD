# Maintainer: Lance <Gero3977@gmail.com>
maintainer="Lance <Gero3977@gmail.com>"
pkgname=firmware-lge-joan
pkgver=1.0
pkgrel=2
pkgdesc="LG V30 (joan) GPU, Bluetooth, modem, ADSP, IPA and WLAN firmware"
url="https://github.com/ShapeShifter499/firmware-lge-joan"
arch="aarch64"
license="proprietary"
depends="firmware-qcom-adreno-a530 linux-firmware-ath10k"
subpackages="$pkgname-initramfs:firmware_initramfs:noarch"
options="!check !strip !archcheck !spdx !tracedeps pmb:cross-native"

_joan_commit="2489e95801110695e991394245b6d7ae66670c4e"
_common_commit="274a1e49a783b971eb967f6afd303b3ec38c9a1b"
_joan_url="https://raw.githubusercontent.com/TheMuppets/proprietary_vendor_lge_joan/$_joan_commit/proprietary/vendor/firmware"
_common_url="https://raw.githubusercontent.com/TheMuppets/proprietary_vendor_lge_joan-common/$_common_commit/proprietary/vendor/firmware"

source="
	a540_gpmu.fw2::$_common_url/a540_gpmu.fw2
	crbtfw21.tlv::$_common_url/crbtfw21.tlv
	crnv21.bin::$_common_url/crnv21.bin
	H930-a540_zap.mdt::$_joan_url/H930/a540_zap.mdt
	H930-a540_zap.b00::$_joan_url/H930/a540_zap.b00
	H930-a540_zap.b01::$_joan_url/H930/a540_zap.b01
	H930-a540_zap.b02::$_joan_url/H930/a540_zap.b02
	H932-a540_zap.mdt::$_joan_url/H932/a540_zap.mdt
	H932-a540_zap.b00::$_joan_url/H932/a540_zap.b00
	H932-a540_zap.b01::$_joan_url/H932/a540_zap.b01
	H932-a540_zap.b02::$_joan_url/H932/a540_zap.b02
	owner-firmware-lge-joan.tar
	joan-firmware-variant
	30-lge-joan-gpu.files
	"

package() {
	local _variant
	local _part

	mkdir -p "$pkgdir/usr/lib/firmware"
	cp -a "$srcdir/owner-firmware-lge-joan/." \
		"$pkgdir/usr/lib/firmware/"
	ln -s qcom/msm8998/joan/wlanmdsp.mbn \
		"$pkgdir/usr/lib/firmware/wlanmdsp.mbn"

	install -Dm644 "$srcdir/a540_gpmu.fw2" \
		"$pkgdir/usr/lib/firmware/qcom/a540_gpmu.fw2"
	install -Dm644 "$srcdir/crbtfw21.tlv" \
		"$pkgdir/usr/lib/firmware/qca/crbtfw21.tlv"
	install -Dm644 "$srcdir/crnv21.bin" \
		"$pkgdir/usr/lib/firmware/qca/crnv21.bin"

	for _variant in H930 H932; do
		for _part in mdt b00 b01 b02; do
			install -Dm644 "$srcdir/$_variant-a540_zap.$_part" \
				"$pkgdir/usr/lib/firmware/qcom/lge/joan/$_variant/a540_zap.$_part"
		done
	done

	install -Dm755 "$srcdir/joan-firmware-variant" \
		"$pkgdir/usr/bin/joan-firmware-variant"
}

firmware_initramfs() {
	pkgdesc="Early GPU and Bluetooth firmware list for the LG V30 initramfs"
	depends="$pkgname=$pkgver-r$pkgrel firmware-qcom-adreno-a530"

	install -Dm644 "$srcdir/30-lge-joan-gpu.files" \
		"$subpkgdir/usr/share/mkinitfs/files/30-lge-joan-gpu.files"
}

