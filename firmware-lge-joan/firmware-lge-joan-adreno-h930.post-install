#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu

cat >&2 <<'MSG'
firmware-lge-joan-adreno-h930 installs the H930-compatible A540 zap shader.

  Correct for: H930, US998, H932PR and every other V30 except an exact LG-H932.
  WRONG for:   an exact LG-H932.

The zap payload is signed per model. Installing the wrong one does not damage
anything, but the GPU will refuse it and the display will not come up.

MSG

if [ -r /proc/cmdline ]; then
	model=$(tr ' ' '\n' < /proc/cmdline \
		| sed -n 's/^androidboot\.vendor\.lge\.model\.name=//p' | head -1)
	if [ -n "$model" ]; then
		case "$model" in
		LG-H932)
			want=h932 ;;
		*)
			want=h930 ;;
		esac
		if [ "$want" != "h930" ]; then
			echo "WARNING: this device reports $model, which wants" >&2
			echo "         firmware-lge-joan-adreno-$want, not -h930." >&2
			echo "         Install that instead:" >&2
			echo "           apk add firmware-lge-joan-adreno-$want" >&2
		else
			echo "This device reports $model: correct package." >&2
		fi
	else
		echo "Bootloader model not in /proc/cmdline; cannot confirm the choice." >&2
		echo "Check with: joan-firmware-variant --explain" >&2
	fi
fi

exit 0
