maintainer="Lance <Gero3977@gmail.com>"
pkgname=alsa-ucm-conf-lge-joan
pkgver=1.0
pkgrel=0
pkgdesc="ALSA UCM profile for the LG V30 (joan) sound card"
url="https://github.com/ShapeShifter499/lg-v30-joan-pmos-packages"
arch="noarch"
license="BSD-3-Clause"
depends="alsa-ucm-conf"
options="!check"
source="
	LG-V30.conf
	HiFi.conf
	"

package() {
	# Entry point, matched on the card's long name under the driver dir.
	install -Dm644 "$srcdir/LG-V30.conf" \
		"$pkgdir/usr/share/alsa/ucm2/conf.d/sdm845/LG-V30.conf"

	install -Dm644 "$srcdir/HiFi.conf" \
		"$pkgdir/usr/share/alsa/ucm2/Qualcomm/sdm845-lge-joan/HiFi.conf"
}

